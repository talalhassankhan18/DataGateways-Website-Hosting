# Copy to .env and fill in. Never commit the filled-in version.
# Every mailbox below is [CONFIRM] in docs/copy-deck.md — the client must confirm each one is
# routed before this goes anywhere public.

# --- Runtime -----------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# The single origin allowed to call this API. In production this is the real site origin.
SITE_ORIGIN=http://localhost:3000

# Number of proxy hops in front of the API. Leave at 0 unless there genuinely is a proxy:
# trusting a forwarded header nobody sets lets a caller spoof its IP past the rate limiter.
TRUST_PROXY_HOPS=0

# --- Contact rate limiting ---------------------------------------------------------------------
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=60

# --- Mail transport ----------------------------------------------------------------------------
# Required when NODE_ENV=production. Without them the API starts in development and logs
# enquiries instead of delivering them; in production it refuses to boot rather than
# silently dropping messages.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- Routed mailboxes, one per contact-wizard branch -------------------------------------------
MAILBOX_EVALUATE=
MAILBOX_PARTNER=
MAILBOX_SUPPORT=
MAILBOX_CAREERS=
