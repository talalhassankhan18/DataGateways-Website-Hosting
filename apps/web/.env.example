# Leave empty to use the Vite /api proxy in local development.
VITE_API_URL=

# Google Analytics 4 measurement ID, "G-XXXXXXXXXX".
#
# Empty is a valid, supported state and the default for a local checkout: no gtag.js script is
# injected, no request is made, and every tracking call in the app becomes a no-op. Nothing needs
# guarding at the call sites.
#
# Set it to measure locally against a test GA4 property. Do NOT point a local run at the
# production property -- development traffic would be indistinguishable from real visitors.
# See docs/ANALYTICS.md.
VITE_GA_MEASUREMENT_ID=
