VITE_API_URL=https://channel.datagateways.net

# Production GA4 measurement ID for www.datagateways.net.
#
# Fourth ID supplied: G-G9BBDT5TQV (10-12 Oct), G-8NYB1W6Z6P (never used), G-P817Q57NCR (12 Oct),
# now G-YEG8CLH6T0. GA4 properties do not merge, so whatever each one collected stays in it.
#
# This is not a secret -- it ships in the client-side bundle and is visible to anyone who views
# source. It is committed on purpose (see the !apps/web/.env.production exception in .gitignore)
# so a build is reproducible without out-of-band configuration.
#
# Setting this is what makes analytics live: the gtag.js tag loads and the consent banner appears.
# Clearing it turns the whole integration inert again, banner included. See docs/ANALYTICS.md.
VITE_GA_MEASUREMENT_ID=G-YEG8CLH6T0
