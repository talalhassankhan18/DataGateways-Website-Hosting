{
  "name": "@datagateways/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/sync-assets.mjs",
    "dev": "vite",
    "prebuild": "node ../../scripts/sync-assets.mjs",
    "build": "npm run typecheck && vite build",
